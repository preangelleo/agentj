{
 "schema": "agentj.plaza-audit/v1",
 "note": "P426 #181-2: the static audit of a plaza package — ONE rule table for the host (agentj/plaza_audit.py) and the Dashboard (dashboard/src/plaza_audit.ts), each with its own matcher. Deterministic, zero model. Every pattern is matched line by line against every UTF-8 file of the package and every manifest string (flags: i = ignore case). Patterns use only the regex subset Python `re` and JavaScript share (no inline flags, fixed-width lookbehind only). block = refused at publish, upload, certify and install; warn = shown, the owner decides. `cases` are vectors both matchers must agree on.",
 "rules": [
  {
   "id": "remote-exec",
   "level": "block",
   "flags": "i",
   "zh": "从网上下载代码后直接运行（像 curl … | sh）：装上以后，那台服务器想让你的电脑跑什么就跑什么",
   "en": "downloads code and runs it straight away (like curl … | sh): once installed, whoever controls that server decides what your computer runs",
   "patterns": [
    "\\b(?:curl|wget|fetch)\\b[^|\\n]*\\|\\s*(?:sudo\\s+(?:-\\S+\\s+)*)?(?:env\\s+)?(?:ba|z|da|k|fi|c|tc)?sh\\b",
    "\\b(?:curl|wget)\\b[^|\\n]*\\|\\s*(?:sudo\\s+)?(?:python[0-9.]*|node|perl|ruby|php)\\b",
    "\\b(?:ba|z|da|k)?sh\\s+(?:-c\\s+)?[\"']?\\$\\(\\s*(?:curl|wget)\\b",
    "\\b(?:ba|z|da|k)?sh\\s+<\\(\\s*(?:curl|wget)\\b",
    "\\b(?:iex|invoke-expression)\\b[^\\n]*\\b(?:irm|iwr|invoke-restmethod|invoke-webrequest|downloadstring)\\b",
    "\\b(?:irm|iwr|invoke-restmethod|invoke-webrequest)\\b[^|\\n]*\\|\\s*(?:iex|invoke-expression)\\b",
    "\\b(?:exec|eval)\\s*\\(\\s*(?:requests\\.get|urllib\\.request\\.urlopen|urlopen)\\s*\\("
   ]
  },
  {
   "id": "decode-exec",
   "level": "block",
   "flags": "i",
   "zh": "先把一段看不懂的编码（base64 等）解开再运行：藏起来的命令，人和审核都看不到",
   "en": "decodes a hidden blob (base64 or similar) and runs it: a command neither you nor a reviewer can read",
   "patterns": [
    "\\bbase64\\s+(?:-d|--decode|-D)\\b[^\\n]*\\|\\s*(?:sudo\\s+)?(?:ba|z|da|k)?sh\\b",
    "\\b(?:exec|eval)\\s*\\(\\s*(?:base64\\.b64decode|codecs\\.decode|bytes\\.fromhex|__import__\\(\\s*[\"']base64)",
    "\\beval\\s*\\(\\s*(?:atob|buffer\\.from)\\s*\\(",
    "frombase64string[^\\n]*\\|\\s*(?:iex|invoke-expression)\\b",
    "\\b(?:iex|invoke-expression)\\b[^\\n]*frombase64string",
    "\\bpowershell(?:\\.exe)?\\b[^\\n]*\\s-(?:e|en|enc|encodedcommand)\\s+[a-z0-9+/=]{20,}"
   ]
  },
  {
   "id": "credential-files",
   "level": "block",
   "flags": "i",
   "zh": "读取电脑上的登录钥匙或密码库：SSH 私钥、云服务凭据、钥匙串、浏览器保存的 cookie 和密码",
   "en": "reads the computer's login keys or password stores: SSH private keys, cloud credentials, the keychain, cookies and passwords saved in a browser",
   "patterns": [
    "\\.ssh/id_(?:rsa|dsa|ecdsa|ed25519)(?![\\w.]*\\.pub)\\b",
    "\\.aws/credentials\\b",
    "\\.config/gcloud/(?:credentials|application_default_credentials|legacy_credentials)",
    "\\.kube/config\\b",
    "\\.docker/config\\.json\\b",
    "(?:~|\\$home|\\$\\{home\\})/\\.(?:netrc|git-credentials|gnupg|password-store)\\b",
    "\\bsecurity\\s+(?:find-generic-password|find-internet-password|dump-keychain)\\b",
    "(?:google/chrome|chromium|bravesoftware|microsoft/edge|mozilla/firefox|\\.mozilla)[^\\n]*(?:cookies|login data|logins\\.json|key4\\.db)",
    "\\b(?:browser_cookie3|pycookiecheat)\\b"
   ]
  },
  {
   "id": "env-exfil",
   "level": "block",
   "flags": "i",
   "zh": "把电脑上的全部环境变量（里面常有各种密钥）发到外面",
   "en": "sends every environment variable of the computer (where keys often live) to somewhere outside",
   "patterns": [
    "\\b(?:printenv|env|set)\\s*\\|\\s*(?:curl|wget|nc|ncat|socat)\\b",
    "\\b(?:curl|wget)\\b[^\\n]*\\$\\(\\s*(?:printenv|env)\\s*\\)",
    "\\b(?:curl|wget)\\b[^\\n]*/proc/self/environ",
    "\\b(?:requests|httpx|session)\\.(?:post|put|patch)\\s*\\([^\\n]*\\b(?:dict\\(\\s*)?os\\.environ\\b(?!\\s*(?:\\[|\\.get))",
    "\\bjson\\.dumps\\(\\s*(?:dict\\(\\s*)?os\\.environ\\b(?!\\s*(?:\\[|\\.get))",
    "json\\.stringify\\(\\s*process\\.env\\s*\\)"
   ]
  },
  {
   "id": "file-upload",
   "level": "block",
   "flags": "i",
   "zh": "把你电脑上的文件上传到外部网址",
   "en": "uploads files from your computer to an outside address",
   "patterns": [
    "\\bcurl\\b[^\\n]*\\s(?:-F|--form)\\s+[\"']?[\\w.\\[\\]-]*=@[\"']?(?:~|/|\\$home|\\$\\{home\\})",
    "\\bcurl\\b[^\\n]*\\s(?:--data-binary|--data-raw|--data|-d)\\s+[\"']?@[\"']?(?:~|/|\\$home|\\$\\{home\\})",
    "\\bcurl\\b[^\\n]*\\s(?:-T|--upload-file)\\s+[\"']?(?:~|/|\\$home|\\$\\{home\\})",
    "\\bscp\\b[^\\n]*\\s[\"']?(?:~|\\$home|\\$\\{home\\})/\\S*\\s+\\S+@\\S+:"
   ]
  },
  {
   "id": "delete-everything",
   "level": "block",
   "flags": "",
   "zh": "删除整个家目录或整个系统",
   "en": "deletes the whole home folder or the whole system",
   "patterns": [
    "\\brm\\s+(?:-[a-zA-Z]+\\s+)*-[a-zA-Z]*[rR][a-zA-Z]*\\s+(?:-[a-zA-Z-]+\\s+)*[\\\"']?(?:/|~|\\$HOME|\\$\\{HOME\\})[\\\"']?/?\\*?(?=\\s|$|;|&|\\|)"
   ]
  },
  {
   "id": "prompt-injection",
   "level": "block",
   "flags": "i",
   "zh": "里面有想操纵 AI 的话（比如叫它丢掉原来的规矩、瞒着你做事）：装上后，你的 Agent 可能被它牵着走",
   "en": "contains words written to steer the AI (telling it to drop its earlier rules or to hide things from you): once installed, it could lead your Agent astray",
   "patterns": [
    "\\b(?:ignore|disregard|forget|override)\\s+(?:all\\s+|any\\s+|every\\s+)?(?:of\\s+)?(?:the\\s+|your\\s+)?(?:previous|prior|above|earlier|preceding|system|original)\\s+(?:instructions?|prompts?|rules|directions|guidelines|messages)",
    "忽略(?:掉)?(?:之前|以上|上面|前面|先前|此前|所有|一切|全部)(?:的|所有的)?(?:所有|全部)?(?:指令|指示|命令|规则|提示词?|说明|设定|要求)",
    "无视(?:之前|以上|上面|前面|所有|一切)(?:的)?(?:指令|指示|命令|规则|提示词?|要求)",
    "\\b(?:do\\s+not|don't|dont|never)\\s+(?:tell|inform|notify|alert)\\s+(?:the\\s+)?(?:user|owner|human)s?\\s+(?:about|that|what|you|we|this|anything)\\b",
    "(?:不要|别|不得|切勿|不许)(?:告诉|告知|通知|提醒|让)(?:用户|主人|人类|你的人|使用者)(?:你|我们|这|此|关于|任何|正在|做了|在做)"
   ]
  },
  {
   "id": "role-override",
   "level": "warn",
   "flags": "i",
   "zh": "有改写 AI 身份的说法（比如「你现在是…」）：多数是正常的角色设定，但也可能是想换掉你 Agent 的规矩，请看一眼",
   "en": "rewrites who the AI is (like \"you are now …\"): usually a normal role description, but it could also try to replace your Agent's rules — take a look",
   "patterns": [
    "\\byou\\s+are\\s+now\\s+(?:a|an|the|in|dan)\\b",
    "你现在(?:是|扮演|变成|就是)",
    "\\bnew\\s+(?:system\\s+)?instructions?\\s*:",
    "\\b(?:reveal|print|show|output|repeat)\\s+(?:your|the)\\s+(?:system\\s+prompt|hidden\\s+instructions)"
   ]
  },
  {
   "id": "dotenv-read",
   "level": "warn",
   "flags": "i",
   "zh": "会读取 .env 文件（通常放着密钥）：多数是读它自己要的那几个，请确认",
   "en": "reads a .env file (where keys usually live): usually just the ones it needs — please check",
   "patterns": [
    "\\bload_dotenv\\s*\\(",
    "\\bdotenv\\.config\\s*\\(",
    "\\bopen\\s*\\(\\s*[\"'][^\"'\\n]*\\.env[\"']",
    "(?:^|[\\s;&|(])(?:cat|source|less|head|tail)\\s+[\"']?(?:[\\w~$./-]*/)?\\.env(?![\\w.])"
   ]
  },
  {
   "id": "secret-dirs",
   "level": "warn",
   "flags": "i",
   "zh": "提到了电脑上放钥匙的文件夹（~/.ssh、~/.aws）或保存的密码：请确认它为什么需要",
   "en": "mentions the folders where the computer keeps keys (~/.ssh, ~/.aws) or saved passwords: check why it needs them",
   "patterns": [
    "(?:~|\\$home|\\$\\{home\\})/\\.(?:ssh|aws)\\b",
    "\\bsecret-tool\\s+lookup\\b",
    "\\bkeyring\\.get_password\\s*\\("
   ]
  },
  {
   "id": "sudo",
   "level": "warn",
   "flags": "",
   "zh": "会用 sudo 要管理员权限：Agent J 会在手机上单独问你，但请先想清楚它为什么需要",
   "en": "asks for administrator rights with sudo: Agent J asks you on the phone each time, but consider why it needs them",
   "patterns": [
    "(?:^|[\\s;&|(`])sudo\\s+[^\\s-]"
   ]
  }
 ],
