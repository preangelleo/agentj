{
  "$schema": "https://agentj.app/schema/agentj-theme-1.json",
  "schema": 1,
  "id": "dots",
  "name": {
    "zh": "圆点",
    "en": "Dots"
  },
  "description": "Factory preset: the round dots from before the robots — one per Agent working in the background, softly blinking, no dancing.",
  "author": "Agent J",
  "colors": {
    "state": {
      "idle": "#629887",
      "working": "#6a9bcc",
      "waiting": "#d97757",
      "question": "#827dbd",
      "offline": "#858585"
    },
    "card": {
      "owner": "#ffe292",
      "agent": "#cacadb",
      "computer": "#c7dedc",
      "developer": "#c1e1f0",
      "system": "#efddcf"
    }
  },
  "busy": {
    "style": "dots",
    "dots": {
      "colors": [
        {
          "heavy": "#71bbde",
          "light": "#c1e1f0"
        },
        {
          "heavy": "#d1a7e8",
          "light": "#ebd8f5"
        },
        {
          "heavy": "#f7827e",
          "light": "#fbc8c6"
        },
        {
          "heavy": "#dbb293",
          "light": "#efddcf"
        },
        {
          "heavy": "#f0aad4",
          "light": "#f8daec"
        },
        {
          "heavy": "#fcbe7c",
          "light": "#fee2c5"
        },
        {
          "heavy": "#f7e17c",
          "light": "#fbf2c5"
        },
        {
          "heavy": "#b7e396",
          "light": "#dff3d1"
        },
        {
          "heavy": "#78dedc",
          "light": "#c4f0f0"
        }
      ],
      "blink": true
    }
  }
}
