{
  "$schema": "https://agentj.app/schema/agentj-card-1.json",
  "schemaVersion": 1,
  "id": "notes",
  "version": "1.0.0",
  "name": {
    "zh": "记事本",
    "en": "Notebook"
  },
  "description": {
    "zh": "你和 Agent 一起管的记事本：在手机上看，让 Agent 记、改、整理。",
    "en": "A notebook you keep with your Agent: read it here, the Agent writes, edits and tidies it."
  },
  "author": "Agent J",
  "icon": "note",
  "accent": "emerald-oasis",
  "template": "notes",
  "plus": "agentj-add-note",
  "data": {
    "file": "notes.md",
    "maxBytes": 65536
  },
  "actions": [
    {
      "id": "add",
      "label": {
        "zh": "记一条",
        "en": "Add a note"
      },
      "draft": true,
      "prompt": {
        "zh": "/agentj-add-note",
        "en": "/agentj-add-note"
      }
    },
    {
      "id": "tidy",
      "label": {
        "zh": "帮我整理",
        "en": "Tidy it up"
      },
      "prompt": {
        "zh": "/agentj-add-note tidy",
        "en": "/agentj-add-note tidy"
      }
    }
  ]
}
