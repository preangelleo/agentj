{
  "$schema": "https://agentj.app/schema/agentj-card-1.json",
  "schemaVersion": 1,
  "id": "todo",
  "version": "1.1.0",
  "name": {
    "zh": "待办",
    "en": "To-do"
  },
  "description": {
    "zh": "你和 Agent J 一起维护的待办：写明谁负责、何时开始、何时截止，做完划掉。",
    "en": "To-dos you and Agent J keep together: who does it, when it starts, when it is due; done ones are struck through."
  },
  "author": "Agent J",
  "icon": "checklist",
  "accent": "windstorm",
  "template": "checklist",
  "plus": "agentj-add-todo",
  "data": {
    "file": "todo.json",
    "maxBytes": 65536
  },
  "actions": [
    {
      "id": "add",
      "label": {
        "zh": "加一条",
        "en": "Add an item"
      },
      "draft": true,
      "prompt": {
        "zh": "/agentj-add-todo",
        "en": "/agentj-add-todo"
      }
    },
    {
      "id": "sort",
      "label": {
        "zh": "排个先后",
        "en": "Prioritise"
      },
      "prompt": {
        "zh": "/agentj-add-todo sort",
        "en": "/agentj-add-todo sort"
      }
    }
  ],
  "itemActions": [
    {
      "id": "toggle",
      "label": {
        "zh": "完成 / 撤回",
        "en": "Done / undo"
      },
      "prompt": {
        "zh": "/agentj-add-todo toggle {{item.id}}",
        "en": "/agentj-add-todo toggle {{item.id}}"
      }
    }
  ],
  "aliases": [
    "待办卡",
    "待办事项",
    "To-do card",
    "Todo"
  ]
}
