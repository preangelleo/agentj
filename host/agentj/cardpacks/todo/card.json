{
  "$schema": "https://agentj.app/schema/agentj-card-1.json",
  "schemaVersion": 1,
  "id": "todo",
  "version": "1.0.0",
  "name": {
    "zh": "待办",
    "en": "To-do"
  },
  "description": {
    "zh": "待办清单：点一条让 Agent 标完成或撤回，新增和整理也交给它。",
    "en": "Your to-do list: tap an item and the Agent ticks it off or reopens it; it adds and sorts items too."
  },
  "author": "Agent J",
  "icon": "checklist",
  "accent": "windstorm",
  "template": "checklist",
  "plus": "agentj-add-todo",
  "data": {
    "file": "todo.json",
    "maxBytes": 65536
  },
  "actions": [
    {
      "id": "add",
      "label": {
        "zh": "加一条",
        "en": "Add an item"
      },
      "draft": true,
      "prompt": {
        "zh": "/agentj-add-todo",
        "en": "/agentj-add-todo"
      }
    },
    {
      "id": "sort",
      "label": {
        "zh": "排个先后",
        "en": "Prioritise"
      },
      "prompt": {
        "zh": "/agentj-add-todo sort",
        "en": "/agentj-add-todo sort"
      }
    }
  ],
  "itemActions": [
    {
      "id": "toggle",
      "label": {
        "zh": "完成 / 撤回",
        "en": "Done / undo"
      },
      "prompt": {
        "zh": "/agentj-add-todo toggle {{item.id}}",
        "en": "/agentj-add-todo toggle {{item.id}}"
      }
    }
  ]
}
