    "voice.tts.provider": {
      "type": "string",
      "default": "openai",
      "description": "Own-key provider; reply audio crosses our relay only as ciphertext / 自有密钥服务商；回复音频只以密文经过中继",
      "aliases": [
        "voice tts provider",
        "播报服务商"
      ],
      "tier": "user",
      "apply": "hot",
      "verify": "agentj config validate --json",
      "since": "0.12",
      "enum": [
        "openai",
        "elevenlabs",
        "command"
      ]
    },
    "voice.tts.model": {
      "type": "string",
      "default": "gpt-realtime-2.1-mini",
      "description": "Cloud speech model / 云端语音模型",
      "aliases": [
        "voice tts model",
        "播报模型"
      ],
      "tier": "user",
      "apply": "hot",
      "verify": "agentj config validate --json",
      "since": "0.12",
      "maxLength": 160,
      "providerDefaults": {
        "elevenlabs": "eleven_v4"
      }
    },
    "voice.tts.key_env": {
      "type": "string",
      "default": "OPENAI_API_KEY",
      "description": "Environment variable NAME only / 仅环境变量名",
      "aliases": [
        "voice tts key env",
        "播报密钥变量"
      ],
      "tier": "user",
