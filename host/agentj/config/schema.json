      "tier": "locked",
      "apply": "hot",
      "verify": "agentj config validate --json",
      "since": "0.12"
    },
    "voice.wake_word": {
      "type": "string",
      "default": "",
      "description": "Empty follows 嘿 + Agent name / 留空跟随 Agent 名",
      "aliases": [
        "唤醒词",
        "wake word",
        "hotword",
        "voice wake word"
      ],
      "tier": "user",
