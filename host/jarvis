#!/usr/bin/env bash
# agentjarvis host CLI launcher (alpha). Named `jarvis` inside this directory only — it does not shadow another `jarvis` on PATH.
# Uses the project-local venv (uv); creates it on first run.
set -euo pipefail
here="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd -P)"
if [[ ! -x "$here/.venv/bin/python" ]]; then
  uv sync --project "$here" --no-dev -q
fi
PYTHONPATH="$here${PYTHONPATH:+:$PYTHONPATH}" exec "$here/.venv/bin/python" -m jarvis_host.cli "$@"
