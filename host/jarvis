#!/usr/bin/env bash
# Compatibility launcher (one version cycle): this checkout's CLI used to be `host/jarvis`; it is `host/bin/agentj` now.
# Prints one notice line on stderr, then runs the same CLI.
set -euo pipefail
here="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd -P)"
if [[ ! -x "$here/.venv/bin/python" ]]; then
  uv sync --project "$here" --no-dev -q
fi
PYTHONPATH="$here${PYTHONPATH:+:$PYTHONPATH}" exec "$here/.venv/bin/python" -m jarvis_host.cli "$@"
