{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agentj:design:p86:report:1",
  "title": "report proposed design",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "task_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9.-]{0,79}$"
    },
    "brief_revision": {
      "type": "integer",
      "minimum": 1
    },
    "brief_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "status": {
      "enum": [
        "ok",
        "attention",
        "fail"
      ]
    },
    "acceptance": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9.-]{0,79}$"
          },
          "status": {
            "enum": [
              "pass",
              "fail",
              "unverified",
              "skipped"
            ]
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9][A-Za-z0-9_./-]{0,200}$"
            },
            "minItems": 0,
            "maxItems": 10
          }
        },
        "required": [
          "id",
          "status",
          "evidence_refs"
        ]
      },
      "minItems": 1,
      "maxItems": 20
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9][A-Za-z0-9_./-]{0,200}$"
      },
      "minItems": 0,
      "maxItems": 20
    },
    "unprocessed": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500
      },
      "minItems": 0,
      "maxItems": 30
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500
      },
      "minItems": 0,
      "maxItems": 20
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500
      },
      "minItems": 0,
      "maxItems": 20
    },
    "recoveries": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500
      },
      "minItems": 0,
      "maxItems": 20
    },
    "approval_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9][A-Za-z0-9_./-]{0,200}$"
      },
      "minItems": 0,
      "maxItems": 20
    },
    "next_step": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    }
  },
  "required": [
    "schema_version",
    "task_id",
    "brief_revision",
    "brief_digest",
    "status",
    "acceptance",
    "artifacts",
    "unprocessed",
    "blockers",
    "assumptions",
    "recoveries",
    "approval_refs",
    "next_step"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "ok"
          }
        }
      },
      "then": {
        "properties": {
          "acceptance": {
            "items": {
              "properties": {
                "status": {
                  "const": "pass"
                },
                "evidence_refs": {
                  "minItems": 1
                }
              }
            }
          },
          "artifacts": {
            "minItems": 1
          },
          "unprocessed": {
            "maxItems": 0
          },
          "blockers": {
            "maxItems": 0
          }
        }
      }
    }
  ]
}
