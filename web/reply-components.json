{
  "version": 1,
  "fence": "agentj",
  "maxChars": 16000,
  "maxComponents": 20,
  "components": [
    {
      "name": "link",
      "syntax": "existing",
      "example": "[label](https://example.com)",
      "renderer": "safeHref / shownTarget",
      "description": "External URL / 外部网址",
      "parameters": {
        "label": "Visible text",
        "href": "http:, https:, mailto: only; shows real host"
      }
    },
    {
      "name": "internal-link",
      "syntax": "existing",
      "example": "card/cards",
      "renderer": "five-pages.linkify",
      "description": "Internal navigation / 内部导航",
      "parameters": {
        "address": "Known card/<id>[#anchor], /installed-skill, workflow mentions; no invented URL scheme"
      }
    },
    {
      "name": "quote",
      "syntax": "existing",
      "example": "> quoted words",
      "renderer": "md blockquote",
      "description": "Quotation / 引用",
      "parameters": {
        "text": "Markdown > block; actions stay inert"
      }
    },
    {
      "name": "file",
      "syntax": "existing",
      "example": "[report.pdf](out/report.pdf)",
      "renderer": "media / localRef",
      "description": "Host-authorized Markdown, PDF, audio, video / 主机授权文件",
      "parameters": {
        "ref": "Host-authorized local path",
        "mid": "Host media id",
        "mime": "Markdown / PDF / audio / video; metadata comes from host"
      }
    },
    {
      "name": "table",
      "syntax": "existing",
      "example": "| Item | Count |\n|---|---|\n| Mug | 60 |",
      "renderer": "md table",
      "description": "Markdown table / 表格",
      "parameters": {
        "columns": "≤32",
        "rows": "≤300",
        "cells": "≤4000"
      }
    },
    {
      "name": "reply",
      "syntax": "existing",
      "example": "[A](reply:A)",
      "renderer": "replybtn / replyRef",
      "description": "Existing one-tap reply / 原有单击发送选项",
      "parameters": {
        "label": "Visible choice",
        "say": "One-line bounded reply: text; existing one-tap send"
      }
    },
    {
      "name": "todo",
      "syntax": "existing",
      "example": "Ask Agent J to update the To-do card / 请 Agent J 更新待办卡",
      "renderer": "jcards",
      "description": "Owner-managed persistent checklist / 持久待办卡",
      "parameters": {
        "card": "Owner official To-do card; not an inline permission card"
      }
    },
    {
      "name": "mermaid",
      "syntax": "existing",
      "example": "```mermaid\nflowchart LR\n A[Start] --> B[Done]\n```",
      "renderer": "render.diagram",
      "description": "Local strict Mermaid / 本地严格流程图",
      "parameters": {
        "source": "≤10000 chars; local strict rendering; text fallback"
      }
    },
    {
      "name": "flowchart",
      "syntax": "agentj",
      "renderer": "flowchart",
      "description": "Named nodes and directed edges / 节点与有向连线",
      "schema": {
        "type": "object",
        "properties": {
          "component": {
            "enum": [
              "flowchart"
            ]
          },
          "title": {
            "type": "string",
            "maxLength": 200
          },
          "nodes": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "maxLength": 24
                },
                "label": {
                  "type": "string",
                  "maxLength": 120
                }
              },
              "required": [
                "id",
                "label"
              ],
              "additionalProperties": false
            },
            "maxItems": 24,
            "minItems": 1
          },
          "edges": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "from": {
                  "type": "string",
                  "maxLength": 24
                },
                "to": {
                  "type": "string",
                  "maxLength": 24
                }
              },
              "required": [
                "from",
                "to"
              ],
              "additionalProperties": false
            },
            "maxItems": 40,
            "minItems": 1
          }
        },
        "required": [
          "component",
          "title",
          "nodes",
          "edges"
        ],
        "additionalProperties": false
      },
      "example": {
        "component": "flowchart",
        "title": "Flowchart",
        "nodes": [
          {
            "id": "a",
            "label": "Review"
          },
          {
            "id": "b",
            "label": "Done"
          }
        ],
        "edges": [
          {
            "from": "a",
            "to": "b"
          }
        ]
      }
    },
    {
      "name": "chart",
      "syntax": "agentj",
      "renderer": "chart",
      "description": "Finite numeric bar or line chart / 有限数值柱图或折线图",
      "schema": {
        "type": "object",
        "properties": {
          "component": {
            "enum": [
              "chart"
            ]
          },
          "title": {
            "type": "string",
            "maxLength": 200
          },
          "kind": {
            "enum": [
              "bar",
              "line"
            ]
          },
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "label": {
                  "type": "string",
                  "maxLength": 60
                },
                "value": {
                  "type": "number",
                  "minimum": -1000000000,
                  "maximum": 1000000000
                }
              },
              "required": [
                "label",
                "value"
              ],
              "additionalProperties": false
            },
            "maxItems": 30,
            "minItems": 1
          }
        },
        "required": [
          "component",
          "title",
          "kind",
          "items"
        ],
        "additionalProperties": false
      },
      "example": {
        "component": "chart",
        "title": "Chart",
        "kind": "bar",
        "items": [
          {
            "label": "Mug",
            "value": 60
          },
          {
            "label": "Cap",
            "value": 40
          }
        ]
      }
    },
    {
      "name": "steps",
      "syntax": "agentj",
      "renderer": "steps",
      "description": "Read-only progress / 只读步骤条",
      "schema": {
        "type": "object",
        "properties": {
          "component": {
            "enum": [
              "steps"
            ]
          },
          "title": {
            "type": "string",
            "maxLength": 200
          },
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "label": {
                  "type": "string",
                  "maxLength": 120
                },
                "status": {
                  "enum": [
                    "pending",
                    "active",
                    "done"
                  ]
                }
              },
              "required": [
                "label",
                "status"
              ],
              "additionalProperties": false
            },
            "maxItems": 12,
            "minItems": 1
          }
        },
        "required": [
          "component",
          "title",
          "items"
        ],
        "additionalProperties": false
      },
      "example": {
        "component": "steps",
        "title": "Steps",
        "items": [
          {
            "label": "Review",
            "status": "active"
          },
          {
            "label": "Deliver",
            "status": "pending"
          }
        ]
      }
    },
    {
      "name": "confirm",
      "syntax": "agentj",
      "renderer": "confirm",
      "description": "Draft only, never a permission approval / 只填草稿，不是权限批准",
      "schema": {
        "type": "object",
        "properties": {
          "component": {
            "enum": [
              "confirm"
            ]
          },
          "title": {
            "type": "string",
            "maxLength": 200
          },
          "message": {
            "type": "string",
            "maxLength": 1000
          },
          "choices": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 100
            },
            "maxItems": 4,
            "minItems": 1
          }
        },
        "required": [
          "component",
          "title",
          "message",
          "choices"
        ],
        "additionalProperties": false
      },
      "example": {
        "component": "confirm",
        "title": "Confirm",
        "message": "Review the proposed restock order.",
        "choices": [
          "Prepare order",
          "Keep draft"
        ]
      }
    },
    {
      "name": "form",
      "syntax": "agentj",
      "renderer": "form",
      "description": "Non-secret inputs → draft / 非秘密表单只生成草稿",
      "schema": {
        "type": "object",
        "properties": {
          "component": {
            "enum": [
              "form"
            ]
          },
          "title": {
            "type": "string",
            "maxLength": 200
          },
          "fields": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "maxLength": 24
                },
                "label": {
                  "type": "string",
                  "maxLength": 100
                },
                "type": {
                  "enum": [
                    "text",
                    "select",
                    "checkbox",
                    "date"
                  ]
                },
                "options": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "maxLength": 100
                  },
                  "maxItems": 12,
                  "minItems": 1
                }
              },
              "required": [
                "id",
                "label",
                "type"
              ],
              "additionalProperties": false
            },
            "maxItems": 8,
            "minItems": 1
          }
        },
        "required": [
          "component",
          "title",
          "fields"
        ],
        "additionalProperties": false
      },
      "example": {
        "component": "form",
        "title": "Form",
        "fields": [
          {
            "id": "note",
            "label": "Notes",
            "type": "text"
          }
        ]
      }
    }
  ]
}
