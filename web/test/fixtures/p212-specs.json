 "grill-startup.zh": {
  "schema": "agentj.form/v1",
  "lang": "zh",
  "title": "项目启动拷问 · 宠物店在线预约",
  "intro": "每题都有我的推荐（黄底），同意就不用改；「不确定」永远可以选——我会把它记成要验证的假设。",
  "sections": [
   {
    "id": "user",
    "questions": [
     {
      "id": "who",
      "type": "single",
      "label": "第一批用户是谁？",
      "required": true,
      "options": [
       {
        "value": "u1",
        "label": "社区宠物店店主"
       },
       {
        "value": "u2",
        "label": "上门洗护师"
       },
       {
        "value": "unsure",
        "label": "不确定"
       }
      ],
      "other": true,
      "rec": "u1"
     },
     {
      "id": "now",
      "type": "longtext",
      "label": "他们现在怎么解决这个问题？",
      "required": true,
      "max_length": 1000
     },
     {
      "id": "freq",
      "type": "buttons",
      "label": "多久痛一次？",
      "options": [
       {
        "value": "daily",
        "label": "每天"
       },
       {
        "value": "weekly",
        "label": "每周"
       },
       {
        "value": "rare",
        "label": "偶尔"
       }
      ],
      "rec": "weekly"
     },
     {
      "id": "reach",
      "type": "single",
      "label": "你能直接找到 10 个这样的人吗？",
      "options": [
       {
        "value": "yes",
        "label": "能，现在就能"
       },
       {
        "value": "some",
        "label": "能找到几个"
       },
       {
        "value": "no",
        "label": "不能"
       }
      ],
      "rec": "some"
     }
    ],
    "title": "用户",
    "intro": "先定是谁在痛。"
   },
   {
    "id": "value",
    "questions": [
     {
      "id": "promise",
      "type": "text",
      "label": "一句话：用了它，用户得到什么？",
      "required": true,
      "max_length": 200
     },
     {
      "id": "pain",
      "type": "slider",
      "label": "不用它，用户有多痛？",
      "min": 1,
      "max": 10,
      "step": 1,
      "labels": [
       "无所谓",
       "非解决不可"
      ],
      "default": 6,
      "rec": 7
     },
     {
      "id": "alt",
      "type": "rank",
      "label": "用户最可能的替代选择（最像的放最上）",
      "options": [
       {
        "value": "diy",
        "label": "自己动手 / Excel"
       },
       {
        "value": "competitor",
        "label": "现成产品"
       },
       {
        "value": "nothing",
        "label": "忍着不管"
       }
      ]
     }
    ],
    "title": "价值"
   },
   {
    "id": "money",
    "questions": [
     {
      "id": "model",
      "type": "single",
      "label": "怎么收钱？",
      "required": true,
      "options": [
       {
        "value": "sub",
        "label": "订阅"
       },
       {
        "value": "once",
        "label": "一次性"
       },
       {
        "value": "commission",
        "label": "抽成"
       },
       {
        "value": "unsure",
        "label": "不确定"
       }
      ],
      "other": true,
      "rec": "sub"
     },
     {
      "id": "price",
      "type": "number",
      "label": "第一版定价（每月 / 每单）",
      "min": 0,
      "unit": "元"
     },
     {
      "id": "first10",
      "type": "longtext",
      "label": "前 10 个付费用户从哪来？",
      "max_length": 1000
     }
    ],
    "title": "赚钱"
   },
   {
    "id": "scope",
    "questions": [
     {
      "id": "core",
      "type": "longtext",
      "label": "第一版只做哪一件事？",
      "required": true,
      "max_length": 600
     },
     {
      "id": "weeks",
      "type": "slider",
      "label": "几周内上线？",
      "min": 1,
      "max": 12,
      "step": 1,
      "unit": "周",
      "default": 4,
      "rec": 4
     },
     {
      "id": "skip",
      "type": "multi",
      "label": "第一版先不做（勾上的都砍掉）",
      "options": [
       {
        "value": "login",
        "label": "账号体系"
       },
       {
        "value": "pay",
        "label": "在线支付"
       },
       {
        "value": "app",
        "label": "手机 App"
       },
       {
        "value": "admin",
        "label": "后台管理"
       },
       {
        "value": "i18n",
        "label": "多语言"
       }
      ],
      "min": 0,
      "max": 5,
      "rec": [
       "login",
       "app",
       "admin",
       "i18n"
      ]
     }
    ],
    "title": "第一版"
   },
   {
    "id": "risk",
    "questions": [
     {
      "id": "kill",
      "type": "longtext",
      "label": "什么情况会让这件事失败？",
      "required": true,
      "max_length": 1000
     },
     {
      "id": "test",
      "type": "text",
      "label": "最便宜的验证办法",
      "max_length": 300
     },
     {
      "id": "disagree",
      "type": "longtext",
      "label": "上面哪一条推荐，你其实不同意？",
      "hint": "一路「同意」往往是还没想；挑一条说说。",
      "max_length": 600
     },
     {
      "id": "proof",
      "type": "file",
      "label": "用户聊天截图、录音或调研材料（可选）",
      "accept": [
       "image",
       "audio",
       "file"
      ],
      "max_files": 5
     }
    ],
    "title": "风险"
   }
  ],
  "preselect": true,
  "mode": "deep",
  "n": 17
 },
