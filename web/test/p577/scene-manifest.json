    {
      "id": "component-02",
      "name": "品牌基础内容",
      "reason": "Shared brand CSS library has no aj-card/callout/badge/table/prose/code consumers in this Web App index, js or brand JS; no component is fabricated for a screenshot."
    }
  ],
  "criticalRequirements": [
    "Explicit idle,working,waiting-permission,waiting-question,stopped,offline,offline-long",
    "Default/min/max chat font through actual settings controls",
    "reduced-motion reduce and no-preference critical chat/approval/question",
    "Source multi-quote folded/expanded and composer quotes are distinct",
    "Active is a CDP forced visual pseudo-state, not a longpress interaction",
    "Every snapshot must settle to two identical decoded RGBA frames; 0 pixel threshold",
    "Touch mode is separate 390x844 light/dark zh/en with true tap/focus transfer"
